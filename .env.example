# =============================================================================
# Device Info X Server — environment configuration
#
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env` file — it is already excluded via .gitignore.
#
# Generate random secrets with:
#   openssl rand -hex 32
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Swagger UI / ReDoc / raw OpenAPI schema are disabled unless explicitly enabled.
ENABLE_DOCS=false
LOG_LEVEL=INFO

# Public domain this server is reachable at (used for TURN URLs, cookie/host
# checks, and documentation links). Must match your DDNS / DNS hostname.
DOMAIN=example.duckdns.org

# Tag of the wwwescape/device-info-x-server image to run when pulling from
# Docker Hub instead of building from source (see README). Ignored if you
# build locally with `docker compose up --build`.
API_IMAGE_TAG=latest

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=device_info_x
POSTGRES_USER=device_info_x
POSTGRES_PASSWORD=change-me-generate-a-strong-random-password

# --- Auth / JWT ----------------------------------------------------------------
# 32+ bytes of random hex. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-generate-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Optional extra secret mixed into password hashing. Leave blank to disable.
PASSWORD_PEPPER=

# One-time shared secret required to create the first two (and only two)
# accounts on this server. Give it to both partners, then forget it — the
# registration endpoint permanently refuses requests once 2 accounts exist.
SERVER_SETUP_TOKEN=change-me-generate-a-strong-random-token

# --- Media storage ---------------------------------------------------------------
MEDIA_ROOT=/data/media
MAX_IMAGE_SIZE_MB=15
MAX_VOICE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=150
MAX_AVATAR_SIZE_MB=5
MAX_LOCKER_FILE_SIZE_MB=50
# "x-accel" (default, production): Nginx serves downloads itself via
# X-Accel-Redirect. Set to "direct" only for local dev without Nginx in front
# (see docker-compose.override.yml.example).
MEDIA_SERVE_MODE=x-accel

# --- Firebase Cloud Messaging ------------------------------------------------
# Path (inside the api container) to the service-account JSON downloaded from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. See README.md "Firebase setup" for step-by-step instructions.
FIREBASE_SERVICE_ACCOUNT_JSON=/run/secrets/firebase-service-account.json

# --- Coturn (TURN/STUN) ---------------------------------------------------------
# Shared secret between the api container and coturn's `static-auth-secret`.
TURN_STATIC_SECRET=change-me-generate-a-strong-random-secret
TURN_URLS=turn:example.duckdns.org:3478?transport=udp,turn:example.duckdns.org:3478?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- In-app update check ------------------------------------------------------
# The APK download link shown when the client's build is behind the latest one recorded via
# `python -m app.cli set-latest-build`. Use GitHub's own "latest release" alias so this never
# needs updating per-release — it always resolves to whatever the newest release's matching
# asset is, as long as every release re-uploads under the same filename.
APK_DOWNLOAD_URL=https://github.com/<owner>/<repo>/releases/latest/download/app-release.apk

# --- Postgres port exposed to host (dev only, see docker-compose.override.yml.example) ---
# POSTGRES_HOST_PORT=5432
